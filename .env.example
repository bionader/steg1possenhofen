# Steg 1 Possenhofen — .env-Vorlage
#
# Diese Datei ist committet und enthaelt KEINE Werte, nur die Variablennamen.
# Die echte .env liegt lokal im Repo-Root und ist per .gitignore ausgeschlossen.
#
# Werte zusammensetzen aus:
#  - Supabase Dashboard   -> SUPABASE_URL, SUPABASE_ANON_KEY
#  - Resend Dashboard      -> RESEND_API_KEY
#  - hCaptcha Dashboard    -> HCAPTCHA_SECRET
#  - OpenWeatherMap        -> OWM_API_KEY
#  - Apple-Passwort-Gruppe "Steg 1" -> IONOS_MAIL_*, ADMIN/SCHEDULE_EVENTS/SUP-Logins
#
# Hinweis: SUPABASE_URL und SUPABASE_ANON_KEY stehen ohnehin im Frontend-HTML und
# sind nicht geheim. Alles andere hier ist sensibel.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Admin-Panel-Logins (Supabase Auth) -----------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
SCHEDULE_EVENTS_EMAIL=
SCHEDULE_EVENTS_PASSWORD=
SUP_EMAIL=
SUP_PASSWORD=

# --- Mailversand / Captcha / Wetter -------------------------------------
RESEND_API_KEY=
HCAPTCHA_SECRET=
OWM_API_KEY=

# --- IONOS-Postfaecher (SMTP-Login pro Adresse) -------------------------
IONOS_MAIL_INFO_USER=
IONOS_MAIL_INFO_PASSWORD=
IONOS_MAIL_HALLO_USER=
IONOS_MAIL_HALLO_PASSWORD=
IONOS_MAIL_CATHRIN_USER=
IONOS_MAIL_CATHRIN_PASSWORD=
